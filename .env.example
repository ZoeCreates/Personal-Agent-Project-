# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。

# ---- 模型（至少填一个 API Key）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# auto | anthropic | openai | groq | ollama
# auto：有 ANTHROPIC_API_KEY 时用 Anthropic，否则用 OpenAI / Groq
LLM_PROVIDER=auto

# Anthropic 主模型，以及失败时依次尝试的备用模型（逗号分隔）
MODEL=claude-sonnet-4-6
FALLBACK_MODELS=claude-3-5-haiku-latest

# OpenAI 兼容接口（OpenAI / Groq / Ollama 等）
# 不填时：OpenAI 默认 gpt-4o-mini；Groq 默认 llama-3.3-70b-versatile
OPENAI_MODEL=
OPENAI_BASE_URL=

# ---- 渠道 ----
TELEGRAM_TOKEN=
# Web UI 登录密码；留空则不需要登录（仅建议本地使用）
WEB_PASSWORD=
# 部署时 APP_MODE=web 运行 Web UI，否则运行 Telegram Bot
APP_MODE=
# Web UI 端口与调试模式
PORT=5001
FLASK_DEBUG=false

# ---- 可选集成 ----
# 设置后启用 GitHub MCP server
GITHUB_TOKEN=
GITHUB_USERNAME=
# Notion 待办工具：integration token 和待办数据库 ID
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Agent 行为 ----
MAX_TOOL_STEPS=12
# 超过多少小时的过期提醒不再发送
REMINDER_MAX_OVERDUE_HOURS=2
# 要禁用的 skill 名称，逗号分隔
DISABLED_SKILLS=

# ---- 工作区与权限 ----
# Agent 可写的目录，默认 ./workspace
MY_AGENT_WORKSPACE_ROOT=
# 可读 / 可写目录列表，用系统路径分隔符（macOS/Linux 为 :）分隔；留空使用默认值
MY_AGENT_READ_ROOTS=
MY_AGENT_WRITE_ROOTS=
# filesystem MCP 是否只能访问工作区
MY_AGENT_RESTRICT_MCP_TO_WORKSPACE=true
# 跳过工具审批（仅建议在本地测试时开启）
MY_AGENT_AUTO_APPROVE_TOOLS=false

# ---- MCP ----
MY_AGENT_DISABLE_MCP=false
MY_AGENT_MCP_CONNECT_TIMEOUT=10

# ---- 审计日志 ----
MY_AGENT_DISABLE_TOOL_AUDIT=false
# 默认 ~/.my-agent/tool_audit.jsonl
MY_AGENT_TOOL_AUDIT_FILE=
